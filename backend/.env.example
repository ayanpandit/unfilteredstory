# ── App ──
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host:5432/unfilter_story

# ── JWT ──
JWT_SECRET=your-strong-secret-here
JWT_EXPIRATION=1d

# ── Redis (optional — falls back to in-memory cache) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Master Admin (created on first startup) ──
MASTER_ADMIN_USERNAME=masteradmin
MASTER_ADMIN_PASSWORD=ChangeThisStrongPassword123
MASTER_ADMIN_EMAIL=master@yourdomain.com
MASTER_ADMIN_NAME=Master Admin

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-cms.vercel.app
